# ── Job Matcher Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Provider: anthropic | openai | openrouter | ollama | (any OpenAI-compatible)
# Anthropic is recommended — it enables live web search for job sourcing.
JM_PROVIDER=anthropic

# Your API key for the chosen provider
JM_API_KEY=your_api_key_here

# Model to use. Must be a model available on your chosen provider.
# Anthropic:   claude-sonnet-4-6  (recommended)
# OpenAI:      gpt-4o
# OpenRouter:  openai/gpt-4o  or  anthropic/claude-sonnet-4-6  (etc.)
# Ollama:      llama3  (or any locally available model)
JM_MODEL=claude-sonnet-4-6

# Custom base URL — only needed for OpenRouter, Ollama, or self-hosted providers.
# Leave blank for Anthropic or OpenAI.
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1
JM_API_BASE_URL=

# Your resume or career document filename (place file in this directory).
# Plain text (.txt) works best. PDF or DOCX should be converted to text first.
JM_RESUME_FILE=resume.txt

# Match threshold: only listings scoring >= this percent appear in the report.
# Default is 60. Raise to tighten results, lower to see more options.
JM_MIN_MATCH_PCT=60

# Number of distinct job board search queries to run per session.
# More searches = broader coverage but higher API cost. Default is 8.
JM_MAX_SEARCHES=8
